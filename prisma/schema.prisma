// Esquema de base de datos — Plataforma de Clases Particulares (MVP)
// Ver MVP-plataforma-clases-particulares.md, sección 4, para el modelo original.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  student
  teacher
  admin
}

enum Modality {
  in_person
  online
  both
}

enum Level {
  primaria
  eso
  bachillerato
  universidad
  adultos
}

enum TeacherStatus {
  pending
  approved
  rejected
}

enum UserStatus {
  active
  suspended
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String?
  role          Role       @default(student)
  status        UserStatus @default(active)
  name          String
  avatarUrl     String?
  emailVerified DateTime?
  createdAt     DateTime   @default(now())

  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  teacherProfile TeacherProfile?

  sentMessages          Message[]      @relation("MessageSender")
  studentConversations  Conversation[] @relation("StudentConversations")
  teacherConversations  Conversation[] @relation("TeacherConversations")

  @@map("users")
}

// Perfil de profesor (el "anuncio")
model TeacherProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  bio            String?
  pricePerHour   Decimal       @db.Decimal(10, 2)
  modality       Modality
  city           String?
  postalCode     String?
  experienceText String?
  status         TeacherStatus @default(pending)
  createdAt      DateTime      @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects  TeacherSubject[]
  materials Material[]

  @@index([status])
  @@index([city])
  @@map("teacher_profiles")
}

// Categorías de nivel superior que estructuran la web: Ciencias, Humanidades,
// Oposiciones, Cursos oficiales (idiomas). Cada Subject pertenece a una.
model Subject {
  id       String @id @default(cuid())
  name     String @unique
  category String

  teacherSubjects TeacherSubject[]
  materials       Material[]

  @@index([category])
  @@map("subjects")
}

// Material didáctico que un profesor deja disponible para descarga, asociado a una materia
model Material {
  id               String   @id @default(cuid())
  title            String
  description      String?
  subjectId        String
  teacherProfileId String
  fileUrl          String
  fileName         String
  createdAt        DateTime @default(now())

  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@map("materials")
}

// Tabla puente: un profesor puede impartir varias materias a distintos niveles
model TeacherSubject {
  teacherProfileId String
  subjectId        String
  level            Level

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherProfileId, subjectId, level])
  @@map("teacher_subjects")
}

model Conversation {
  id        String   @id @default(cuid())
  studentId String
  teacherId String
  createdAt DateTime @default(now())

  student  User      @relation("StudentConversations", fields: [studentId], references: [id])
  teacher  User      @relation("TeacherConversations", fields: [teacherId], references: [id])
  messages Message[]

  @@unique([studentId, teacherId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@map("messages")
}

// --- Auth.js (NextAuth) — adapter de Prisma + recuperación de contraseña ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
