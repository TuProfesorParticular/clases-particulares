# Base de datos (Supabase, Railway, o Postgres local)
DATABASE_URL="postgresql://usuario:password@localhost:5432/tuprofesorparticular?schema=public"

# Auth.js — genera uno con: npx auth secret
AUTH_SECRET=""

# Google OAuth (opcional, fase 1 puede omitirse)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Envío de emails (verificación de cuenta, recuperación de contraseña, notificaciones)
# Sin RESEND_API_KEY, los emails se imprimen por consola en vez de enviarse (modo dev).
RESEND_API_KEY=""
EMAIL_FROM="no-reply@tuprofesorparticular.com"

# URL pública de la app (para construir enlaces en los emails)
APP_URL="http://localhost:3000"

# Supabase Storage (subida de foto de perfil) — Project Settings > Data API / API Keys
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Fotos rotativas del hero (profesor con alumno) — cuenta gratuita en pexels.com/api
# Sin esta clave, el hero se muestra sin fotos de fondo (degradado suave, sin errores).
PEXELS_API_KEY=""
